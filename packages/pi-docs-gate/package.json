{
  "name": "@alphagodzilla/pi-docs-gate",
  "version": "0.1.0",
  "description": "pi 扩展:把内置系统提示词里硬编码的 Pi documentation 段落按需化(普通目录覆盖为 (none) 占位、~/.pi/agent 下换成引导读 pi-docs skill 的提示),结构化段与线上提示词文本两条路径同时生效",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.ts"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlphaGodzilla/ag-pi-mono.git",
    "directory": "packages/pi-docs-gate"
  },
  "homepage": "https://github.com/AlphaGodzilla/ag-pi-mono/tree/main/packages/pi-docs-gate#readme",
  "bugs": {
    "url": "https://github.com/AlphaGodzilla/ag-pi-mono/issues"
  }
}
